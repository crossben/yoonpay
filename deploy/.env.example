# ---- Required
YOON_DOMAIN=pay.example.com
YOON_PUBLIC_URL=https://pay.example.com
POSTGRES_PASSWORD=
# Operator API (/admin/v1): a random secret of at least 32 characters.
YOON_ADMIN_TOKEN=
# Read-mostly operator dashboard at https://<YOON_DOMAIN>/dashboard (needs YOON_ADMIN_TOKEN).
# YOON_DASHBOARD_ENABLED=true
# Hosted checkout page (checkout=hosted, at https://<YOON_DOMAIN>/checkout/...; needs YOON_PUBLIC_URL).
# Unused checkouts fail after this long; public checkout requests allowed per minute per client (0 = off).
# YOON_CHECKOUT_TTL=30m
# YOON_CHECKOUT_RATE_LIMIT=300
# Pin a version; upgrade deliberately (docs/runbook.md).
YOON_IMAGE=ghcr.io/crossben/yoon:0.1

# ---- Per application (after `docker compose run --rm yoon apps create shop`)
# YOON_APPS_SHOP_WEBHOOK_URL=https://shop.example.com/yoon/webhook
# YOON_APPS_SHOP_WEBHOOK_SECRET=
# YOON_APPS_SHOP_PROVIDERS_PAYDUNYA_PRIORITY=1
# YOON_APPS_SHOP_PROVIDERS_PAYDUNYA_CREDENTIALS_MASTER_KEY=
# YOON_APPS_SHOP_PROVIDERS_PAYDUNYA_CREDENTIALS_PRIVATE_KEY=
# YOON_APPS_SHOP_PROVIDERS_PAYDUNYA_CREDENTIALS_TOKEN=
# YOON_APPS_SHOP_PROVIDERS_PAYDUNYA_CREDENTIALS_MODE=live

# ---- Monitoring profile
GRAFANA_ADMIN_PASSWORD=
