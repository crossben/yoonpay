<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>dev.yoonpay</groupId>
    <artifactId>yoon-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <name>Yoon</name>
    <description>Self-hosted, open-source payment gateway for African payment providers</description>
    <url>https://github.com/crossben/yoonpay</url>

    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
        </license>
    </licenses>

    <modules>
        <module>yoon-core</module>
        <module>yoon-testkit</module>
        <module>yoon-providers</module>
        <module>yoon-server</module>
        <module>clients/java</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <archunit.version>1.5.1</archunit.version>
        <resilience4j.version>2.4.0</resilience4j.version>
        <libphonenumber.version>9.0.40</libphonenumber.version>
        <shedlock.version>7.10.1</shedlock.version>
        <wiremock.version>3.13.2</wiremock.version>
        <swagger-ui.version>5.32.15</swagger-ui.version>
        <swagger-request-validator.version>3.0.0</swagger-request-validator.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.yoonpay</groupId>
                <artifactId>yoon-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.yoonpay</groupId>
                <artifactId>yoon-testkit</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.yoonpay</groupId>
                <artifactId>yoon-provider-support</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.yoonpay</groupId>
                <artifactId>yoon-provider-paydunya</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.yoonpay</groupId>
                <artifactId>yoon-provider-dexpay</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.yoonpay</groupId>
                <artifactId>yoon-provider-pispi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.yoonpay</groupId>
                <artifactId>yoon-provider-naboopay</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.yoonpay</groupId>
                <artifactId>yoon-provider-demo</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
